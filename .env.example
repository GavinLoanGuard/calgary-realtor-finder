# ─────────────────────────────────────────────────────────────────────────────
# Calgary Realtor Finder — Environment Variables
# Copy this file to .env.local and fill in each value before running locally.
# On Vercel, set these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key — get yours at resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=

# Nathan Koenigsberg's email — receives all lead notifications (for now)
# To reassign areas to a new agent, update config/agentRouting.ts, not this var.
NATHAN_EMAIL=

# Gavin Dyer's email — CC'd on every lead regardless of routing
GAVIN_EMAIL=

# From address for all outbound emails.
# Must be a verified sender domain in your Resend account.
# Format: Display Name <address@yourdomain.com>
EMAIL_FROM=Calgary Realtor Finder <hello@calgaryrealtorfinder.ca>

# Public site URL — used in confirmation email links and structured data
NEXT_PUBLIC_SITE_URL=https://calgaryrealtorfinder.ca

# ─── Optional: Lead database (Vercel KV / Upstash Redis) ─────────────────────
# Leads are also delivered by email, so KV is a secondary backup.
# To enable: attach a Vercel KV store in your Vercel project dashboard.
# Vercel auto-populates KV_REST_API_URL and KV_REST_API_TOKEN when attached.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Anthropic API — used by /neighbourhood-report AI report generator ────────
# Get your key at console.anthropic.com. Add to Vercel: Project Settings → Env Vars.
# Never prefix with NEXT_PUBLIC_ — this must stay server-side only.
ANTHROPIC_API_KEY=

# ─── Google Tag Manager ───────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
